def node_require(script)
  # Разрешаем путь к скрипту через node для поддержки hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
rescue => e
  Pod::UI.warn "Не удалось подключить #{script} через node: #{e.message}"
  # Fallback - обычный require
  require script
end

# Используем для подключения скриптов React Native и этого пакета:
# Временное решение - закомментируйте node_require и используйте прямой require
# node_require('react-native/scripts/react_native_pods.rb')
# node_require('react-native-permissions/scripts/setup.rb')

# Используйте прямые require с абсолютными путями
require File.join(__dir__, '../node_modules/react-native/scripts/react_native_pods.rb')
require File.join(__dir__, '../node_modules/react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Camera',
  'Notifications',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
])

# Используем статическую линковку фреймворков
$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

target 'BloomApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => true,  # или false если хотите отключить
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
  end
end
